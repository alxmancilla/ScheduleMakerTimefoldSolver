# web-ui environment variables (Vite)
# Copy to .env.local (git-ignored) to override locally, or set at build time.
# NOTE: only variables prefixed with VITE_ are exposed to the client bundle,
# and they are baked in at build time (vite build), not read at runtime.

# Base URL the SPA uses for API calls.
# - Same-origin / reverse-proxy deployment: leave as /api (default in code).
# - Separate-origin deployment: set to the backend's public API URL, e.g.
#     VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api

# Dev-only: target the Vite dev-server proxy forwards /api requests to.
# Override to point `npm run dev` at a remote backend.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Loaded automatically by `vite build`. See .env.example for docs.
# Default assumes the SPA is served behind a reverse proxy that forwards
# /api to the backend (same origin). For a separate-origin backend, override
# here (or in .env.production.local) with the full public API URL, e.g.
#   VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api
